@using HealthCareSystem.Models
@inject HealthCareSystem.Data.AppDbContext _context

@{
    ViewData["Title"] = "Admin Dashboard";
    var adminId = Context.Session.GetInt32("UserId");
    var admin = _context.Admins.FirstOrDefault(a => a.SystemId == adminId);
    string adminName = admin != null ? admin.FirstName + " " + admin.LastName : "Admin";

    var hospital = _context.Hospitals.FirstOrDefault();
    string hospitalName = hospital != null && !string.IsNullOrWhiteSpace(hospital.HospitalName)
                          ? hospital.HospitalName : "ISB Hospital";
    string hospitalCity = hospital != null && !string.IsNullOrWhiteSpace(hospital.City)
                          ? hospital.City : "Islamabad, Pakistan";

    int totalDoctors = _context.Doctors.Count();
    int totalPatients = _context.Users.Count(u => u.UserType.ToLower() == "patient");
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">

<style>
    *, *::before, *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
    }

    :root {
        --teal: #00a896;
        --teal2: #007f72;
        --teal-light: #e6f7f5;
        --gold: #e6a817;
        --sidebar-w: 240px;
        --text-dark: #0d2137;
        --text-mid: #3a5068;
        --text-soft: #6b8fa8;
        --bg: #f0f7f9;
        --card-bg: #ffffff;
        --border: #d0e8e4;
        --sidebar-bg: #0a1e2e;
        --sidebar-bg2: #0d3d35;
    }

    body {
        font-family: 'DM Sans', sans-serif;
        background: var(--bg);
        min-height: 100vh;
        color: var(--text-dark);
    }

    /* ── SIDEBAR ── */
    .sidebar {
        position: fixed;
        top: 0;
        left: 0;
        width: var(--sidebar-w);
        height: 100vh;
        background: linear-gradient(180deg, var(--sidebar-bg) 0%, var(--sidebar-bg2) 100%);
        display: flex;
        flex-direction: column;
        z-index: 100;
        padding: 0 0 20px 0;
        overflow: hidden;
        box-shadow: 4px 0 24px rgba(0,0,0,0.15);
    }

    .sidebar-logo {
        padding: 28px 20px 20px;
        border-bottom: 1px solid rgba(255,255,255,0.1);
        text-align: center;
    }

        .sidebar-logo .logo-icon {
            width: 52px;
            height: 52px;
            background: linear-gradient(135deg, var(--teal), var(--teal2));
            border-radius: 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 10px;
            font-size: 24px;
            box-shadow: 0 4px 20px rgba(0,168,150,0.4);
        }

        .sidebar-logo h4 {
            font-family: 'Playfair Display', serif;
            font-size: 17px;
            color: #f0f6ff;
            letter-spacing: 0.5px;
            margin: 0;
        }

        .sidebar-logo small {
            color: var(--teal);
            font-size: 11px;
            letter-spacing: 2px;
            text-transform: uppercase;
        }

    .nav-section {
        padding: 16px 12px 6px;
        font-size: 10px;
        letter-spacing: 2px;
        text-transform: uppercase;
        color: rgba(255,255,255,0.3);
        font-weight: 600;
    }

    .sidebar nav {
        flex: 1;
        overflow-y: auto;
        padding: 0 12px;
    }

        .sidebar nav a {
            display: flex;
            align-items: center;
            gap: 12px;
            color: rgba(255,255,255,0.65);
            padding: 11px 14px;
            margin: 3px 0;
            text-decoration: none;
            border-radius: 10px;
            font-size: 14px;
            font-weight: 500;
            transition: all 0.25s ease;
        }

            .sidebar nav a i {
                font-size: 17px;
                width: 22px;
                text-align: center;
                flex-shrink: 0;
            }

            .sidebar nav a:hover, .sidebar nav a.active {
                background: rgba(0,168,150,0.2);
                color: #5eebd8;
                border-left: 3px solid var(--teal);
                padding-left: 11px;
            }

    .sidebar-footer {
        padding: 12px;
    }

    .sidebar nav a.logout-link {
        color: rgba(255,120,120,0.75);
    }

        .sidebar nav a.logout-link:hover {
            background: rgba(255,80,80,0.12);
            color: #ff8080;
            border-left: 3px solid #ff8080;
        }

    /* ── TOPBAR ── */
    .topbar {
        position: fixed;
        top: 0;
        left: var(--sidebar-w);
        right: 0;
        height: 64px;
        background: #ffffff;
        border-bottom: 1px solid var(--border);
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0 32px;
        z-index: 99;
        box-shadow: 0 2px 12px rgba(0,0,0,0.06);
    }

    .topbar-left h6 {
        font-size: 13px;
        color: var(--text-soft);
        font-weight: 400;
        margin: 0;
    }

    .topbar-left h5 {
        font-family: 'Playfair Display', serif;
        font-size: 18px;
        color: var(--text-dark);
        margin: 0;
    }

    .topbar-right {
        display: flex;
        align-items: center;
        gap: 16px;
    }

    .topbar-date {
        font-size: 13px;
        color: var(--text-soft);
        padding: 6px 14px;
        background: var(--teal-light);
        border: 1px solid var(--border);
        border-radius: 20px;
    }

    .topbar-profile {
        display: flex;
        align-items: center;
        gap: 10px;
        background: var(--teal-light);
        border: 1px solid var(--border);
        border-radius: 50px;
        padding: 5px 14px 5px 5px;
        text-decoration: none;
        transition: all 0.25s;
    }

        .topbar-profile:hover {
            background: #c8ede8;
            border-color: var(--teal);
        }

        .topbar-profile img {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            object-fit: cover;
            border: 2px solid var(--teal);
        }

        .topbar-profile span {
            font-size: 13px;
            color: var(--text-dark);
            font-weight: 600;
        }

    /* ── MAIN ── */
    .main {
        margin-left: var(--sidebar-w);
        padding-top: 64px;
        min-height: 100vh;
    }

    .content-wrap {
        padding: 40px 36px;
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    /* ── WELCOME CARD ── */
    .welcome-card {
        background: linear-gradient(135deg, var(--teal) 0%, var(--teal2) 100%);
        border-radius: 24px;
        padding: 40px 52px;
        text-align: center;
        max-width: 620px;
        width: 100%;
        position: relative;
        overflow: hidden;
        box-shadow: 0 12px 40px rgba(0,168,150,0.35);
        animation: fadeSlideUp 0.7s ease both;
        color: #fff;
    }

        .welcome-card::before {
            content: '';
            position: absolute;
            top: -60px;
            right: -60px;
            width: 200px;
            height: 200px;
            background: radial-gradient(circle, rgba(255,255,255,0.15) 0%, transparent 70%);
            border-radius: 50%;
        }

        .welcome-card::after {
            content: '';
            position: absolute;
            bottom: -40px;
            left: -40px;
            width: 160px;
            height: 160px;
            background: radial-gradient(circle, rgba(255,255,255,0.1) 0%, transparent 70%);
            border-radius: 50%;
        }

    .welcome-badge {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: rgba(255,255,255,0.2);
        border: 1px solid rgba(255,255,255,0.35);
        color: #fff;
        font-size: 11px;
        font-weight: 600;
        letter-spacing: 2px;
        text-transform: uppercase;
        padding: 5px 14px;
        border-radius: 20px;
        margin-bottom: 18px;
    }

    .welcome-card h1 {
        font-family: 'Playfair Display', serif;
        font-size: 38px;
        color: #fff;
        margin-bottom: 6px;
        position: relative;
        z-index: 1;
    }

        .welcome-card h1 span {
            color: #b2f5ea;
        }

    .welcome-card .subtitle {
        color: rgba(255,255,255,0.8);
        font-size: 15px;
        margin-bottom: 6px;
    }

    .welcome-card .hospital-name {
        font-family: 'Playfair Display', serif;
        font-size: 18px;
        color: #ffe082;
        letter-spacing: 1px;
    }

    .welcome-divider {
        width: 60px;
        height: 3px;
        background: rgba(255,255,255,0.4);
        border-radius: 2px;
        margin: 18px auto;
    }

    .welcome-meta {
        display: flex;
        justify-content: center;
        gap: 24px;
        flex-wrap: wrap;
    }

        .welcome-meta .meta-item {
            display: flex;
            align-items: center;
            gap: 6px;
            font-size: 13px;
            color: rgba(255,255,255,0.8);
        }

            .welcome-meta .meta-item i {
                color: #b2f5ea;
            }

    /* ── STATS ── */
    .stats-section {
        width: 100%;
        max-width: 900px;
        margin-top: 40px;
    }

    .stats-title {
        text-align: center;
        font-size: 12px;
        letter-spacing: 3px;
        text-transform: uppercase;
        color: var(--text-soft);
        margin-bottom: 20px;
    }

    .stats-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 20px;
        max-width: 620px;
        margin: 0 auto;
    }

    .stat-card {
        background: var(--card-bg);
        border: 1px solid var(--border);
        border-radius: 20px;
        padding: 28px 24px;
        text-decoration: none;
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        transition: all 0.3s ease;
        position: relative;
        overflow: hidden;
        animation: fadeSlideUp 0.7s ease both;
        box-shadow: 0 2px 12px rgba(0,0,0,0.06);
    }

        .stat-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 4px;
            border-radius: 20px 20px 0 0;
        }

        .stat-card.doctors::before {
            background: linear-gradient(90deg, #00a896, #0072ff);
        }

        .stat-card.patients::before {
            background: linear-gradient(90deg, #e6a817, #ff8c00);
        }

        .stat-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 16px 40px rgba(0,0,0,0.12);
            border-color: var(--teal);
        }

    .stat-icon {
        width: 60px;
        height: 60px;
        border-radius: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 26px;
        margin-bottom: 14px;
    }

    .stat-card.doctors .stat-icon {
        background: #e6f7f5;
        color: var(--teal);
    }

    .stat-card.patients .stat-icon {
        background: #fef8e6;
        color: var(--gold);
    }

    .stat-count {
        font-family: 'Playfair Display', serif;
        font-size: 44px;
        font-weight: 700;
        line-height: 1;
        margin-bottom: 6px;
    }

    .stat-card.doctors .stat-count {
        color: var(--teal);
    }

    .stat-card.patients .stat-count {
        color: var(--gold);
    }

    .stat-label {
        font-size: 13px;
        color: var(--text-soft);
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    /* ── QUICK ACTIONS ── */
    .actions-section {
        width: 100%;
        max-width: 900px;
        margin-top: 32px;
    }

    .actions-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 14px;
    }

    .action-btn {
        background: var(--card-bg);
        border: 1px solid var(--border);
        border-radius: 14px;
        padding: 16px 12px;
        text-align: center;
        text-decoration: none;
        color: var(--text-mid);
        font-size: 13px;
        font-weight: 500;
        transition: all 0.25s;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 8px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.05);
    }

        .action-btn i {
            font-size: 20px;
            color: var(--teal);
        }

        .action-btn:hover {
            background: var(--teal-light);
            border-color: var(--teal);
            color: var(--text-dark);
            transform: translateY(-3px);
            box-shadow: 0 8px 20px rgba(0,168,150,0.15);
        }

    @@keyframes fadeSlideUp {
        from {
            opacity: 0;
            transform: translateY(30px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    ::-webkit-scrollbar {
        width: 5px;
    }

    ::-webkit-scrollbar-track {
        background: transparent;
    }

    ::-webkit-scrollbar-thumb {
        background: rgba(0,168,150,0.3);
        border-radius: 10px;
    }

    @@media (max-width: 768px) {
        :root {
            --sidebar-w: 0px;
        }

        .sidebar {
            transform: translateX(-100%);
        }

        .stats-grid {
            grid-template-columns: 1fr;
        }

        .actions-grid {
            grid-template-columns: repeat(2,1fr);
        }

        .topbar {
            left: 0;
        }

        .content-wrap {
            padding: 24px 16px;
        }
    }
</style>

<!-- ══ SIDEBAR ══ -->
<div class="sidebar">
    <div class="sidebar-logo">
        <div class="logo-icon">🏥</div>
        <h4>@hospitalName</h4>
        <small>Management System</small>
    </div>

    <div class="nav-section">Main Menu</div>
    <nav>
        <a asp-controller="Admin" asp-action="HelloAdmin" class="active">
            <i class="bi bi-speedometer2"></i> Dashboard
        </a>
        <a asp-controller="Admin" asp-action="AdminProfile">
            <i class="bi bi-person-circle"></i> My Profile
        </a>

        <div class="nav-section" style="padding-left:0">Hospital</div>
        <a asp-controller="Admin" asp-action="HospitalInfo">
            <i class="bi bi-building"></i> Hospital Info
        </a>

        <div class="nav-section" style="padding-left:0">Doctors</div>
        <a asp-controller="Admin" asp-action="NewDoctor">
            <i class="bi bi-person-plus"></i> Add Doctor
        </a>
        <a asp-controller="Admin" asp-action="ViewDoctor">
            <i class="bi bi-person-badge"></i> View Doctors
        </a>

        <div class="nav-section" style="padding-left:0">Patients</div>
        <a asp-controller="Admin" asp-action="ViewPatient">
            <i class="bi bi-people"></i> View Patients
        </a>
    </nav>

    <div class="sidebar-footer">
        <nav>
            <a asp-controller="Admin" asp-action="Logout" class="logout-link">
                <i class="bi bi-box-arrow-left"></i> Logout
            </a>
        </nav>
    </div>
</div>

<!-- ══ TOPBAR ══ -->
<div class="topbar">
    <div class="topbar-left">
        <h6>Good Day 👋</h6>
        <h5>Admin Dashboard</h5>
    </div>
    <div class="topbar-right">
        <span class="topbar-date">
            <i class="bi bi-calendar3 me-1"></i>
            <span id="live-date"></span>
        </span>
        <a asp-controller="Admin" asp-action="AdminProfile" class="topbar-profile">
            <img src="@Url.Content("~/images/admin-profile.png")" alt="Admin" />
            <span>@adminName</span>
        </a>
    </div>
</div>

<!-- ══ MAIN ══ -->
<div class="main">
    <div class="content-wrap">

        <div class="welcome-card">
            <div class="welcome-badge">
                <i class="bi bi-shield-check"></i> Administrator Access
            </div>
            <h1>Hello, <span>@adminName</span></h1>
            <p class="subtitle">Welcome back to your control panel</p>
            <p class="hospital-name">✦ @hospitalName ✦</p>
            <div class="welcome-divider"></div>
            <div class="welcome-meta">
                <div class="meta-item"><i class="bi bi-geo-alt-fill"></i> @hospitalCity</div>
                <div class="meta-item"><i class="bi bi-clock-fill"></i> <span id="live-time"></span></div>
                <div class="meta-item"><i class="bi bi-wifi"></i> System Online</div>
            </div>
        </div>

        <div class="stats-section">
            <p class="stats-title">Hospital Overview</p>
            <div class="stats-grid">
                <a class="stat-card doctors" asp-controller="Admin" asp-action="ViewDoctor">
                    <div class="stat-icon"><i class="bi bi-person-badge-fill"></i></div>
                    <div class="stat-count">@totalDoctors</div>
                    <div class="stat-label">Total Doctors</div>
                </a>
                <a class="stat-card patients" asp-controller="Admin" asp-action="ViewPatient">
                    <div class="stat-icon"><i class="bi bi-people-fill"></i></div>
                    <div class="stat-count">@totalPatients</div>
                    <div class="stat-label">Total Patients</div>
                </a>
            </div>
        </div>

        <div class="actions-section">
            <p class="stats-title">Quick Actions</p>
            <div class="actions-grid">
                <a class="action-btn" asp-controller="Admin" asp-action="AdminProfile">
                    <i class="bi bi-person-circle"></i> My Profile
                </a>
                <a class="action-btn" asp-controller="Admin" asp-action="HospitalInfo">
                    <i class="bi bi-building"></i> Hospital Info
                </a>
                <a class="action-btn" asp-controller="Admin" asp-action="NewDoctor">
                    <i class="bi bi-person-plus-fill"></i> Add Doctor
                </a>
                <a class="action-btn" asp-controller="Admin" asp-action="ViewDoctor">
                    <i class="bi bi-person-lines-fill"></i> View Doctors
                </a>
            </div>
        </div>

    </div>
</div>

<script>
    function updateDateTime() {
        const now = new Date();
        const timeEl = document.getElementById('live-time');
        const dateEl = document.getElementById('live-date');
        if (timeEl) timeEl.textContent = now.toLocaleTimeString('en-PK', { hour: '2-digit', minute: '2-digit' });
        if (dateEl) dateEl.textContent = now.toLocaleDateString('en-PK', { weekday: 'short', day: 'numeric', month: 'short', year: 'numeric' });
    }
    updateDateTime();
    setInterval(updateDateTime, 1000);
</script>
