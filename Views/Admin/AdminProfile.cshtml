@model HealthCareSystem.Models.Admin
@{
    ViewData["Title"] = "Admin Profile";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">

<style>
    *, *::before, *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
    }

    :root {
        --teal: #00a896;
        --teal2: #007f72;
        --teal-light: #e6f7f5;
        --sidebar-w: 240px;
        --text-dark: #0d2137;
        --text-mid: #3a5068;
        --text-soft: #6b8fa8;
        --bg: #f0f7f9;
        --card-bg: #ffffff;
        --border: #d0e8e4;
        --sidebar-bg: #0a1e2e;
        --sidebar-bg2: #0d3d35;
    }

    body {
        font-family: 'DM Sans', sans-serif;
        background: var(--bg);
        min-height: 100vh;
        color: var(--text-dark);
    }

    /* ── SIDEBAR ── */
    .sidebar {
        position: fixed;
        top: 0;
        left: 0;
        width: var(--sidebar-w);
        height: 100vh;
        background: linear-gradient(180deg, var(--sidebar-bg) 0%, var(--sidebar-bg2) 100%);
        display: flex;
        flex-direction: column;
        z-index: 100;
        padding: 0 0 20px 0;
        overflow: hidden;
        box-shadow: 4px 0 24px rgba(0,0,0,0.15);
    }

    .sidebar-logo {
        padding: 28px 20px 20px;
        border-bottom: 1px solid rgba(255,255,255,0.1);
        text-align: center;
    }

        .sidebar-logo .logo-icon {
            width: 52px;
            height: 52px;
            background: linear-gradient(135deg, var(--teal), var(--teal2));
            border-radius: 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 10px;
            font-size: 24px;
            box-shadow: 0 4px 20px rgba(0,168,150,0.4);
        }

        .sidebar-logo h4 {
            font-family: 'Playfair Display', serif;
            font-size: 17px;
            color: #f0f6ff;
            letter-spacing: 0.5px;
            margin: 0;
        }

        .sidebar-logo small {
            color: var(--teal);
            font-size: 11px;
            letter-spacing: 2px;
            text-transform: uppercase;
        }

    .nav-section {
        padding: 16px 12px 6px;
        font-size: 10px;
        letter-spacing: 2px;
        text-transform: uppercase;
        color: rgba(255,255,255,0.3);
        font-weight: 600;
    }

    .sidebar nav {
        flex: 1;
        overflow-y: auto;
        padding: 0 12px;
    }

        .sidebar nav a {
            display: flex;
            align-items: center;
            gap: 12px;
            color: rgba(255,255,255,0.65);
            padding: 11px 14px;
            margin: 3px 0;
            text-decoration: none;
            border-radius: 10px;
            font-size: 14px;
            font-weight: 500;
            transition: all 0.25s ease;
        }

            .sidebar nav a i {
                font-size: 17px;
                width: 22px;
                text-align: center;
                flex-shrink: 0;
            }

            .sidebar nav a:hover, .sidebar nav a.active {
                background: rgba(0,168,150,0.2);
                color: #5eebd8;
                border-left: 3px solid var(--teal);
                padding-left: 11px;
            }

    .sidebar-footer {
        padding: 12px;
    }

    .sidebar nav a.logout-link {
        color: rgba(255,120,120,0.75);
    }

        .sidebar nav a.logout-link:hover {
            background: rgba(255,80,80,0.12);
            color: #ff8080;
            border-left: 3px solid #ff8080;
        }

    /* ── TOPBAR ── */
    .topbar {
        position: fixed;
        top: 0;
        left: var(--sidebar-w);
        right: 0;
        height: 64px;
        background: #ffffff;
        border-bottom: 1px solid var(--border);
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0 32px;
        z-index: 99;
        box-shadow: 0 2px 12px rgba(0,0,0,0.06);
    }

    .topbar-left h6 {
        font-size: 13px;
        color: var(--text-soft);
        font-weight: 400;
        margin: 0;
    }

    .topbar-left h5 {
        font-family: 'Playfair Display', serif;
        font-size: 18px;
        color: var(--text-dark);
        margin: 0;
    }

    .topbar-profile {
        display: flex;
        align-items: center;
        gap: 10px;
        background: var(--teal-light);
        border: 1px solid var(--border);
        border-radius: 50px;
        padding: 5px 14px 5px 5px;
        text-decoration: none;
        transition: all 0.25s;
    }

        .topbar-profile:hover {
            background: #c8ede8;
            border-color: var(--teal);
        }

        .topbar-profile img {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            object-fit: cover;
            border: 2px solid var(--teal);
        }

        .topbar-profile span {
            font-size: 13px;
            color: var(--text-dark);
            font-weight: 600;
        }

    /* ── MAIN ── */
    .main {
        margin-left: var(--sidebar-w);
        padding-top: 64px;
        min-height: 100vh;
    }

    .content-wrap {
        padding: 36px;
        max-width: 860px;
    }

    /* ── PROFILE CARD ── */
    .profile-card {
        background: var(--card-bg);
        border: 1px solid var(--border);
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 4px 24px rgba(0,0,0,0.07);
    }

    .profile-card-header {
        background: linear-gradient(135deg, var(--teal) 0%, var(--teal2) 100%);
        padding: 28px 32px;
        display: flex;
        align-items: center;
        gap: 20px;
        border-bottom: 1px solid var(--border);
    }

    .profile-avatar {
        width: 68px;
        height: 68px;
        border-radius: 50%;
        background: rgba(255,255,255,0.25);
        display: grid;
        place-items: center;
        font-size: 28px;
        font-weight: 700;
        color: #fff;
        border: 3px solid rgba(255,255,255,0.4);
        flex-shrink: 0;
        font-family: 'Playfair Display', serif;
    }

    .profile-card-header h5 {
        font-family: 'Playfair Display', serif;
        font-size: 20px;
        color: #fff;
        margin: 0;
    }

    .role-badge {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        background: rgba(255,255,255,0.2);
        border: 1px solid rgba(255,255,255,0.35);
        color: #fff;
        font-size: 11px;
        font-weight: 600;
        padding: 3px 10px;
        border-radius: 20px;
        margin-top: 6px;
        letter-spacing: 1px;
        text-transform: uppercase;
    }

    .profile-form {
        padding: 32px;
    }

    .section-label {
        font-size: 10px;
        text-transform: uppercase;
        letter-spacing: 2px;
        color: var(--teal);
        font-weight: 600;
        margin-bottom: 14px;
        padding-bottom: 8px;
        border-bottom: 2px solid var(--teal-light);
    }

    .form-label {
        font-size: 12px;
        font-weight: 600;
        color: var(--text-mid);
        margin-bottom: 5px;
        display: block;
    }

    .form-control {
        background: #f8fbfc;
        border: 1px solid var(--border);
        border-radius: 10px;
        padding: 10px 14px;
        font-size: 14px;
        color: var(--text-dark);
        width: 100%;
        transition: all 0.2s;
        font-family: 'DM Sans', sans-serif;
    }

        .form-control:focus {
            outline: none;
            border-color: var(--teal);
            background: var(--teal-light);
            box-shadow: 0 0 0 3px rgba(0,168,150,0.12);
            color: var(--text-dark);
        }

        .form-control option {
            background: #fff;
            color: var(--text-dark);
        }

        .form-control::placeholder {
            color: #a0b8c8;
        }

    .btn-update {
        background: linear-gradient(135deg, var(--teal), var(--teal2));
        color: #fff;
        border: none;
        border-radius: 10px;
        padding: 11px 28px;
        font-size: 14px;
        font-weight: 600;
        font-family: 'DM Sans', sans-serif;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        transition: all 0.2s;
        box-shadow: 0 4px 16px rgba(0,168,150,0.3);
    }

        .btn-update:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 24px rgba(0,168,150,0.4);
        }

    .alert-success-custom {
        background: #e6f7f5;
        border: 1px solid #9eddd6;
        color: var(--teal2);
        border-radius: 10px;
        padding: 12px 16px;
        font-size: 13px;
        font-weight: 500;
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 24px;
    }

    .alert-error-custom {
        background: #fff0f0;
        border: 1px solid #ffb3b3;
        color: #cc3333;
        border-radius: 10px;
        padding: 12px 16px;
        font-size: 13px;
        font-weight: 500;
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 24px;
    }

    ::-webkit-scrollbar {
        width: 5px;
    }

    ::-webkit-scrollbar-track {
        background: transparent;
    }

    ::-webkit-scrollbar-thumb {
        background: rgba(0,168,150,0.3);
        border-radius: 10px;
    }
</style>

<!-- ══ SIDEBAR ══ -->
<div class="sidebar">
    <div class="sidebar-logo">
        <div class="logo-icon">🏥</div>
        <h4>ISB Hospital</h4>
        <small>Management System</small>
    </div>

    <div class="nav-section">Main Menu</div>
    <nav>
        <a asp-controller="Admin" asp-action="HelloAdmin">
            <i class="bi bi-speedometer2"></i> Dashboard
        </a>
        <a asp-controller="Admin" asp-action="AdminProfile" class="active">
            <i class="bi bi-person-circle"></i> My Profile
        </a>

        <div class="nav-section" style="padding-left:0">Hospital</div>
        <a asp-controller="Admin" asp-action="HospitalInfo">
            <i class="bi bi-building"></i> Hospital Info
        </a>

        <div class="nav-section" style="padding-left:0">Doctors</div>
        <a asp-controller="Admin" asp-action="NewDoctor">
            <i class="bi bi-person-plus"></i> Add Doctor
        </a>
        <a asp-controller="Admin" asp-action="ViewDoctor">
            <i class="bi bi-person-badge"></i> View Doctors
        </a>

        <div class="nav-section" style="padding-left:0">Patients</div>
        <a asp-controller="Admin" asp-action="ViewPatient">
            <i class="bi bi-people"></i> View Patients
        </a>
    </nav>

    <div class="sidebar-footer">
        <nav>
            <a asp-controller="Admin" asp-action="Logout" class="logout-link">
                <i class="bi bi-box-arrow-left"></i> Logout
            </a>
        </nav>
    </div>
</div>

<!-- ══ TOPBAR ══ -->
<div class="topbar">
    <div class="topbar-left">
        <h6>Administrator</h6>
        <h5>My Profile</h5>
    </div>
    <div class="topbar-right">
        <a asp-controller="Admin" asp-action="AdminProfile" class="topbar-profile">
            <img src="@Url.Content("~/images/admin-profile.png")" alt="Admin" />
            <span>@(Model?.FirstName + " " + Model?.LastName)</span>
        </a>
    </div>
</div>

<!-- ══ MAIN ══ -->
<div class="main">
    <div class="content-wrap">

        @if (ViewBag.Message != null)
        {
            <div class="alert-success-custom">
                <i class="bi bi-check-circle-fill"></i> @ViewBag.Message
            </div>
        }

        @if (Model == null)
        {
            <div class="alert-error-custom">
                <i class="bi bi-exclamation-circle-fill"></i>
                Session expired. <a href="/Home/Login" style="color:#cc3333;">Please login again.</a>
            </div>
        }
        else
        {
            <div class="profile-card">

                <!-- Header -->
                <div class="profile-card-header">
                    <div class="profile-avatar">
                        @Model.FirstName.Substring(0, 1).ToUpper()
                    </div>
                    <div>
                        <h5>@Model.FirstName @Model.LastName</h5>
                        <div class="role-badge">
                            <i class="bi bi-shield-fill-check"></i> @Model.UserType
                        </div>
                    </div>
                </div>

                <!-- Form -->
                <div class="profile-form">
                    <form method="post" asp-controller="Admin" asp-action="AdminProfile">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="SystemId" value="@Model.SystemId" />
                        <input type="hidden" name="AdminId" value="@Model.AdminId" />
                        <input type="hidden" name="UserType" value="@Model.UserType" />

                        <div class="section-label">Personal Information</div>
                        <div class="row mb-3">
                            <div class="col-md-6 mb-3 mb-md-0">
                                <label class="form-label">First Name</label>
                                <input type="text" name="FirstName" value="@Model.FirstName" class="form-control" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Last Name</label>
                                <input type="text" name="LastName" value="@Model.LastName" class="form-control" />
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6 mb-3 mb-md-0">
                                <label class="form-label">Gender</label>
                                <select name="Gender" class="form-control">
                                    @foreach (var g in new[] { "Male", "Female", "Other" })
                                    {
                                        if (Model.Gender == g)
                                        {
                                            <option value="@g" selected>@g</option>
                                        }
                                        else
                                        {
                                            <option value="@g">@g</option>
                                        }
                                    }
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Age</label>
                                <input type="number" name="Age" value="@Model.Age" class="form-control" min="18" max="100" />
                            </div>
                        </div>

                        <div class="section-label mt-4">Contact Information</div>
                        <div class="mb-3">
                            <label class="form-label">Email Address</label>
                            <input type="email" name="Email" value="@Model.Email" class="form-control" />
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6 mb-3 mb-md-0">
                                <label class="form-label">Phone</label>
                                <input type="text" name="Phone" value="@Model.Phone" class="form-control" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">City</label>
                                <input type="text" name="City" value="@Model.City" class="form-control" />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Address</label>
                            <input type="text" name="Address" value="@Model.Address" class="form-control" />
                        </div>

                        <div class="section-label mt-4">Security</div>
                        <div class="mb-4">
                            <label class="form-label">
                                New Password
                                <span style="color:#a0b8c8; font-size:11px; font-weight:400;">
                                    — leave blank to keep current
                                </span>
                            </label>
                            <input type="password" name="Password" class="form-control" placeholder="Enter new password" />
                        </div>

                        <button type="submit" class="btn-update">
                            <i class="bi bi-check2-circle"></i> Update Profile
                        </button>
                    </form>
                </div>
            </div>
        }
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
