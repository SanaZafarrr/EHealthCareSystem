@model HealthCareSystem.Models.User
@{
    ViewData["Title"] = "Edit Patient";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">

<style>
    *, *::before, *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
    }

    :root {
        --teal: #00c9b1;
        --teal2: #00a896;
        --white: #f0f6ff;
        --glass: rgba(255,255,255,0.07);
        --glass-border: rgba(255,255,255,0.12);
        --sidebar-w: 240px;
    }

    body {
        font-family: 'DM Sans', sans-serif;
        background: url('@Url.Content("~/images/hospital-bg.jpg")') no-repeat center center fixed;
        background-size: cover;
        min-height: 100vh;
        color: var(--white);
    }

        body::before {
            content: '';
            position: fixed;
            inset: 0;
            background: linear-gradient(135deg, rgba(10,22,40,0.92) 0%, rgba(0,168,150,0.18) 100%);
            z-index: 0;
        }

    /* ── SIDEBAR ── */
    .sidebar {
        position: fixed;
        top: 0;
        left: 0;
        width: var(--sidebar-w);
        height: 100vh;
        background: linear-gradient(180deg, rgba(10,22,40,0.98) 0%, rgba(0,100,90,0.85) 100%);
        backdrop-filter: blur(18px);
        border-right: 1px solid var(--glass-border);
        display: flex;
        flex-direction: column;
        z-index: 100;
        padding: 0 0 20px 0;
        overflow: hidden;
    }

    .sidebar-logo {
        padding: 28px 20px 20px;
        border-bottom: 1px solid var(--glass-border);
        text-align: center;
    }

        .sidebar-logo .logo-icon {
            width: 52px;
            height: 52px;
            background: linear-gradient(135deg, var(--teal), var(--teal2));
            border-radius: 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 10px;
            font-size: 24px;
            box-shadow: 0 4px 20px rgba(0,201,177,0.35);
        }

        .sidebar-logo h4 {
            font-family: 'Playfair Display', serif;
            font-size: 17px;
            color: var(--white);
            letter-spacing: 0.5px;
            margin: 0;
        }

        .sidebar-logo small {
            color: var(--teal);
            font-size: 11px;
            letter-spacing: 2px;
            text-transform: uppercase;
        }

    .nav-section {
        padding: 16px 12px 6px;
        font-size: 10px;
        letter-spacing: 2px;
        text-transform: uppercase;
        color: rgba(255,255,255,0.35);
        font-weight: 600;
    }

    .sidebar nav {
        flex: 1;
        overflow-y: auto;
        padding: 0 12px;
    }

        .sidebar nav a {
            display: flex;
            align-items: center;
            gap: 12px;
            color: rgba(255,255,255,0.7);
            padding: 11px 14px;
            margin: 3px 0;
            text-decoration: none;
            border-radius: 10px;
            font-size: 14px;
            font-weight: 500;
            transition: all 0.25s ease;
        }

            .sidebar nav a i {
                font-size: 17px;
                width: 22px;
                text-align: center;
                flex-shrink: 0;
            }

            .sidebar nav a:hover, .sidebar nav a.active {
                background: linear-gradient(90deg, rgba(0,201,177,0.18), rgba(0,201,177,0.05));
                color: var(--teal);
                border-left: 3px solid var(--teal);
                padding-left: 11px;
            }

    .sidebar-footer {
        padding: 12px;
    }

    .sidebar nav a.logout-link {
        color: rgba(255,100,100,0.75);
    }

        .sidebar nav a.logout-link:hover {
            background: rgba(255,80,80,0.12);
            color: #ff6b6b;
            border-left: 3px solid #ff6b6b;
        }

    /* ── TOPBAR ── */
    .topbar {
        position: fixed;
        top: 0;
        left: var(--sidebar-w);
        right: 0;
        height: 64px;
        background: rgba(10,22,40,0.85);
        backdrop-filter: blur(20px);
        border-bottom: 1px solid var(--glass-border);
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0 32px;
        z-index: 99;
    }

    .topbar-left h6 {
        font-size: 13px;
        color: rgba(255,255,255,0.45);
        font-weight: 400;
        margin: 0;
    }

    .topbar-left h5 {
        font-family: 'Playfair Display', serif;
        font-size: 18px;
        color: var(--white);
        margin: 0;
    }

    .topbar-profile {
        display: flex;
        align-items: center;
        gap: 10px;
        background: var(--glass);
        border: 1px solid var(--glass-border);
        border-radius: 50px;
        padding: 5px 14px 5px 5px;
        text-decoration: none;
        transition: all 0.25s;
    }

        .topbar-profile:hover {
            background: rgba(0,201,177,0.12);
            border-color: var(--teal);
        }

        .topbar-profile img {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            object-fit: cover;
            border: 2px solid var(--teal);
        }

        .topbar-profile span {
            font-size: 13px;
            color: var(--white);
            font-weight: 500;
        }

    /* ── MAIN ── */
    .main {
        margin-left: var(--sidebar-w);
        padding-top: 64px;
        min-height: 100vh;
        position: relative;
        z-index: 1;
    }

    .content-wrap {
        padding: 40px 36px;
        display: flex;
        justify-content: center;
    }

    /* ── FORM CARD ── */
    .form-card {
        background: rgba(255,255,255,0.06);
        backdrop-filter: blur(20px);
        border: 1px solid var(--glass-border);
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 20px 60px rgba(0,0,0,0.3);
        width: 100%;
        max-width: 720px;
    }

    .form-card-header {
        background: linear-gradient(135deg, rgba(0,201,177,0.15), rgba(10,22,40,0.9));
        padding: 26px 32px;
        display: flex;
        align-items: center;
        gap: 16px;
        border-bottom: 1px solid var(--glass-border);
    }

    .form-card-icon {
        width: 56px;
        height: 56px;
        border-radius: 14px;
        background: linear-gradient(135deg, var(--teal), var(--teal2));
        display: grid;
        place-items: center;
        font-size: 26px;
        box-shadow: 0 4px 20px rgba(0,201,177,0.35);
        flex-shrink: 0;
    }

    .form-card-header h5 {
        font-family: 'Playfair Display', serif;
        font-size: 20px;
        color: var(--white);
        margin: 0;
    }

    .form-card-header p {
        color: rgba(255,255,255,0.45);
        font-size: 12px;
        margin: 4px 0 0;
    }

    .form-body {
        padding: 32px;
    }

    .section-label {
        font-size: 10px;
        text-transform: uppercase;
        letter-spacing: 2px;
        color: var(--teal);
        font-weight: 600;
        margin-bottom: 16px;
        padding-bottom: 8px;
        border-bottom: 1px solid rgba(0,201,177,0.2);
    }

    .form-label {
        font-size: 12px;
        font-weight: 600;
        color: rgba(255,255,255,0.6);
        margin-bottom: 5px;
        display: block;
    }

    .form-control {
        background: rgba(255,255,255,0.07);
        border: 1px solid var(--glass-border);
        border-radius: 10px;
        padding: 10px 14px;
        font-size: 14px;
        color: var(--white);
        width: 100%;
        transition: all 0.2s;
        font-family: 'DM Sans', sans-serif;
    }

        .form-control:focus {
            outline: none;
            border-color: var(--teal);
            background: rgba(0,201,177,0.08);
            box-shadow: 0 0 0 3px rgba(0,201,177,0.12);
            color: var(--white);
        }

        .form-control::placeholder {
            color: rgba(255,255,255,0.25);
        }

        .form-control option {
            background: #112240;
            color: var(--white);
        }

    /* ── BUTTONS ── */
    .btn-row {
        display: flex;
        gap: 12px;
    }

    .btn-update {
        flex: 1;
        background: linear-gradient(135deg, var(--teal), var(--teal2));
        color: #fff;
        border: none;
        border-radius: 10px;
        padding: 12px;
        font-size: 14px;
        font-weight: 600;
        font-family: 'DM Sans', sans-serif;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        transition: all 0.2s;
        box-shadow: 0 4px 20px rgba(0,201,177,0.3);
    }

        .btn-update:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 28px rgba(0,201,177,0.45);
        }

    .btn-back {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: rgba(255,255,255,0.07);
        border: 1px solid var(--glass-border);
        color: rgba(255,255,255,0.7);
        border-radius: 10px;
        padding: 12px 20px;
        font-size: 14px;
        font-weight: 600;
        text-decoration: none;
        transition: all 0.2s;
    }

        .btn-back:hover {
            background: rgba(255,255,255,0.12);
            color: var(--white);
        }

    ::-webkit-scrollbar {
        width: 5px;
    }

    ::-webkit-scrollbar-track {
        background: transparent;
    }

    ::-webkit-scrollbar-thumb {
        background: rgba(0,201,177,0.3);
        border-radius: 10px;
    }
</style>

<!-- ══ SIDEBAR ══ -->
<div class="sidebar">
    <div class="sidebar-logo">
        <div class="logo-icon">🏥</div>
        <h4>ISB Hospital</h4>
        <small>Management System</small>
    </div>

    <div class="nav-section">Main Menu</div>
    <nav>
        <a asp-controller="Admin" asp-action="HelloAdmin"><i class="bi bi-speedometer2"></i> Dashboard</a>
        <a asp-controller="Admin" asp-action="AdminProfile"><i class="bi bi-person-circle"></i> My Profile</a>

        <div class="nav-section" style="padding-left:0">Hospital</div>
        <a asp-controller="Admin" asp-action="HospitalInfo"><i class="bi bi-building"></i> Hospital Info</a>

        <div class="nav-section" style="padding-left:0">Doctors</div>
        <a asp-controller="Admin" asp-action="NewDoctor"><i class="bi bi-person-plus"></i> Add Doctor</a>
        <a asp-controller="Admin" asp-action="ViewDoctor"><i class="bi bi-person-badge"></i> View Doctors</a>

        <div class="nav-section" style="padding-left:0">Patients</div>
        <a asp-controller="Admin" asp-action="ViewPatient" class="active"><i class="bi bi-people"></i> View Patients</a>
    </nav>

    <div class="sidebar-footer">
        <nav>
            <a asp-controller="Admin" asp-action="Logout" class="logout-link">
                <i class="bi bi-box-arrow-left"></i> Logout
            </a>
        </nav>
    </div>
</div>

<!-- ══ TOPBAR ══ -->
<div class="topbar">
    <div class="topbar-left">
        <h6>Patient Management</h6>
        <h5>Edit Patient</h5>
    </div>
    <div class="topbar-right">
        <a asp-controller="Admin" asp-action="AdminProfile" class="topbar-profile">
            <img src="@Url.Content("~/images/admin-profile.png")" alt="Admin" />
            <span>Admin</span>
        </a>
    </div>
</div>

<!-- ══ MAIN ══ -->
<div class="main">
    <div class="content-wrap">
        <div class="form-card">

            <!-- Card Header -->
            <div class="form-card-header">
                <div class="form-card-icon">✏️</div>
                <div>
                    <h5>Edit Patient Details</h5>
                    <p>Update the information for @Model.FirstName @Model.LastName</p>
                </div>
            </div>

            <!-- Form Body -->
            <div class="form-body">
                <form method="post" asp-controller="Admin" asp-action="EditPatient" autocomplete="off">
                    @Html.AntiForgeryToken()

                    <!-- Hidden fields -->
                    <input type="hidden" name="UserId" value="@Model.UserId" />
                    <input type="hidden" name="UserType" value="@Model.UserType" />

                    <!-- ── SECTION: Personal Information ── -->
                    <div class="section-label">Personal Information</div>

                    <div class="row mb-3">
                        <div class="col-md-6 mb-3 mb-md-0">
                            <label class="form-label">First Name</label>
                            <input type="text" name="FirstName" value="@Model.FirstName"
                                   class="form-control" placeholder="Enter first name" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Last Name</label>
                            <input type="text" name="LastName" value="@Model.LastName"
                                   class="form-control" placeholder="Enter last name" required />
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6 mb-3 mb-md-0">
                            <label class="form-label">Gender</label>
                            <select name="Gender" class="form-control">
                                @foreach (var g in new[] { "Male", "Female", "Other" })
                                {
                                    if (Model.Gender == g)
                                    {
                                        <option value="@g" selected>@g</option>
                                    }
                                    else
                                    {
                                        <option value="@g">@g</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Age</label>
                            <input type="number" name="Age" value="@Model.Age"
                                   class="form-control" min="0" max="150" placeholder="Enter age" />
                        </div>
                    </div>

                    <!-- ── SECTION: Contact Information ── -->
                    <div class="section-label mt-4">Contact Information</div>

                    <div class="row mb-3">
                        <div class="col-md-6 mb-3 mb-md-0">
                            <label class="form-label">Email Address</label>
                            <input type="email" name="Email" value="@Model.Email"
                                   class="form-control" placeholder="Enter email" autocomplete="off" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Phone Number</label>
                            <input type="text" name="Phone" value="@Model.Phone"
                                   class="form-control" placeholder="Enter phone number" />
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6 mb-3 mb-md-0">
                            <label class="form-label">City</label>
                            <input type="text" name="City" value="@Model.City"
                                   class="form-control" placeholder="Enter city" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Address</label>
                            <input type="text" name="Address" value="@Model.Address"
                                   class="form-control" placeholder="Enter address" />
                        </div>
                    </div>

                    <!-- ── SECTION: Account Security ── -->
                    <div class="section-label mt-4">Account Security</div>

                    <div class="mb-4">
                        <label class="form-label">
                            Password
                            <span style="color:rgba(255,255,255,0.3);font-size:11px;font-weight:400;">
                                — leave blank to keep current
                            </span>
                        </label>
                        <input type="password" name="Password" class="form-control"
                               placeholder="Enter new password" autocomplete="new-password" />
                    </div>

                    <!-- ── BUTTONS ── -->
                    <div class="btn-row">
                        <a asp-controller="Admin" asp-action="ViewPatient" class="btn-back">
                            <i class="bi bi-arrow-left"></i> Back
                        </a>
                        <button type="submit" class="btn-update">
                            <i class="bi bi-check2-circle"></i> Save Changes
                        </button>
                    </div>

                </form>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
