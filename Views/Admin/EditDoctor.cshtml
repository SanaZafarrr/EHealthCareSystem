@model HealthCareSystem.Models.Doctor
@using HealthCareSystem.Models
@inject HealthCareSystem.Data.AppDbContext _context
@{
    ViewData["Title"] = "Edit Doctor";
    var adminId = Context.Session.GetInt32("UserId");
    var admin = _context.Admins.FirstOrDefault(a => a.SystemId == adminId);
    string adminName = admin != null ? admin.FirstName + " " + admin.LastName : "Admin";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">

<style>
    *, *::before, *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
    }

    :root {
        --teal: #00a896;
        --teal2: #007f72;
        --teal-light: #e6f7f5;
        --sidebar-w: 240px;
        --text-dark: #0d2137;
        --text-mid: #3a5068;
        --text-soft: #6b8fa8;
        --bg: #f0f7f9;
        --card-bg: #ffffff;
        --border: #d0e8e4;
        --sidebar-bg: #0a1e2e;
        --sidebar-bg2: #0d3d35;
    }

    body {
        font-family: 'DM Sans', sans-serif;
        background: var(--bg);
        min-height: 100vh;
        color: var(--text-dark);
    }

    /* ── SIDEBAR ── */
    .sidebar {
        position: fixed;
        top: 0;
        left: 0;
        width: var(--sidebar-w);
        height: 100vh;
        background: linear-gradient(180deg, var(--sidebar-bg) 0%, var(--sidebar-bg2) 100%);
        display: flex;
        flex-direction: column;
        z-index: 100;
        padding: 0 0 20px 0;
        overflow: hidden;
        box-shadow: 4px 0 24px rgba(0,0,0,0.15);
    }

    .sidebar-logo {
        padding: 28px 20px 20px;
        border-bottom: 1px solid rgba(255,255,255,0.1);
        text-align: center;
    }

        .sidebar-logo .logo-icon {
            width: 52px;
            height: 52px;
            background: linear-gradient(135deg, var(--teal), var(--teal2));
            border-radius: 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 10px;
            font-size: 24px;
            box-shadow: 0 4px 20px rgba(0,168,150,0.4);
        }

        .sidebar-logo h4 {
            font-family: 'Playfair Display', serif;
            font-size: 17px;
            color: #f0f6ff;
            letter-spacing: 0.5px;
            margin: 0;
        }

        .sidebar-logo small {
            color: var(--teal);
            font-size: 11px;
            letter-spacing: 2px;
            text-transform: uppercase;
        }

    .nav-section {
        padding: 16px 12px 6px;
        font-size: 10px;
        letter-spacing: 2px;
        text-transform: uppercase;
        color: rgba(255,255,255,0.3);
        font-weight: 600;
    }

    .sidebar nav {
        flex: 1;
        overflow-y: auto;
        padding: 0 12px;
    }

        .sidebar nav a {
            display: flex;
            align-items: center;
            gap: 12px;
            color: rgba(255,255,255,0.65);
            padding: 11px 14px;
            margin: 3px 0;
            text-decoration: none;
            border-radius: 10px;
            font-size: 14px;
            font-weight: 500;
            transition: all 0.25s ease;
        }

            .sidebar nav a i {
                font-size: 17px;
                width: 22px;
                text-align: center;
                flex-shrink: 0;
            }

            .sidebar nav a:hover, .sidebar nav a.active {
                background: rgba(0,168,150,0.2);
                color: #5eebd8;
                border-left: 3px solid var(--teal);
                padding-left: 11px;
            }

    .sidebar-footer {
        padding: 12px;
    }

    .sidebar nav a.logout-link {
        color: rgba(255,120,120,0.75);
    }

        .sidebar nav a.logout-link:hover {
            background: rgba(255,80,80,0.12);
            color: #ff8080;
            border-left: 3px solid #ff8080;
        }

    /* ── TOPBAR ── */
    .topbar {
        position: fixed;
        top: 0;
        left: var(--sidebar-w);
        right: 0;
        height: 64px;
        background: #ffffff;
        border-bottom: 1px solid var(--border);
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0 32px;
        z-index: 99;
        box-shadow: 0 2px 12px rgba(0,0,0,0.06);
    }

    .topbar-left h6 {
        font-size: 13px;
        color: var(--text-soft);
        font-weight: 400;
        margin: 0;
    }

    .topbar-left h5 {
        font-family: 'Playfair Display', serif;
        font-size: 18px;
        color: var(--text-dark);
        margin: 0;
    }

    .topbar-profile {
        display: flex;
        align-items: center;
        gap: 10px;
        background: var(--teal-light);
        border: 1px solid var(--border);
        border-radius: 50px;
        padding: 5px 14px 5px 5px;
        text-decoration: none;
        transition: all 0.25s;
    }

        .topbar-profile:hover {
            background: #c8ede8;
            border-color: var(--teal);
        }

        .topbar-profile img {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            object-fit: cover;
            border: 2px solid var(--teal);
        }

        .topbar-profile span {
            font-size: 13px;
            color: var(--text-dark);
            font-weight: 600;
        }

    /* ── MAIN ── */
    .main {
        margin-left: var(--sidebar-w);
        padding-top: 64px;
        min-height: 100vh;
    }

    .content-wrap {
        padding: 40px 36px;
        display: flex;
        justify-content: center;
    }

    /* ── FORM CARD ── */
    .form-card {
        background: var(--card-bg);
        border: 1px solid var(--border);
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 4px 24px rgba(0,0,0,0.07);
        width: 100%;
        max-width: 680px;
    }

    .form-card-header {
        background: linear-gradient(135deg, var(--teal) 0%, var(--teal2) 100%);
        padding: 26px 32px;
        display: flex;
        align-items: center;
        gap: 16px;
    }

    .form-card-icon {
        width: 56px;
        height: 56px;
        border-radius: 14px;
        background: rgba(255,255,255,0.2);
        border: 1px solid rgba(255,255,255,0.3);
        display: grid;
        place-items: center;
        font-size: 26px;
        flex-shrink: 0;
    }

    .form-card-header h5 {
        font-family: 'Playfair Display', serif;
        font-size: 20px;
        color: #fff;
        margin: 0;
    }

    .form-card-header p {
        color: rgba(255,255,255,0.75);
        font-size: 12px;
        margin: 4px 0 0;
    }

    .form-body {
        padding: 32px;
    }

    .section-label {
        font-size: 10px;
        text-transform: uppercase;
        letter-spacing: 2px;
        color: var(--teal);
        font-weight: 600;
        margin-bottom: 16px;
        padding-bottom: 8px;
        border-bottom: 2px solid var(--teal-light);
    }

    .form-label {
        font-size: 12px;
        font-weight: 600;
        color: var(--text-mid);
        margin-bottom: 5px;
        display: block;
    }

    .form-control {
        background: #f8fbfc;
        border: 1px solid var(--border);
        border-radius: 10px;
        padding: 10px 14px;
        font-size: 14px;
        color: var(--text-dark);
        width: 100%;
        transition: all 0.2s;
        font-family: 'DM Sans', sans-serif;
    }

        .form-control:focus {
            outline: none;
            border-color: var(--teal);
            background: var(--teal-light);
            box-shadow: 0 0 0 3px rgba(0,168,150,0.12);
            color: var(--text-dark);
        }

        .form-control::placeholder {
            color: #a0b8c8;
        }

        .form-control option {
            background: #fff;
            color: var(--text-dark);
        }

    .btn-row {
        display: flex;
        gap: 12px;
    }

    .btn-update {
        flex: 1;
        background: linear-gradient(135deg, var(--teal), var(--teal2));
        color: #fff;
        border: none;
        border-radius: 10px;
        padding: 12px;
        font-size: 14px;
        font-weight: 600;
        font-family: 'DM Sans', sans-serif;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        transition: all 0.2s;
        box-shadow: 0 4px 16px rgba(0,168,150,0.3);
    }

        .btn-update:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 24px rgba(0,168,150,0.4);
        }

    .btn-back {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: #f0f4f8;
        border: 1px solid var(--border);
        color: var(--text-mid);
        border-radius: 10px;
        padding: 12px 20px;
        font-size: 14px;
        font-weight: 600;
        text-decoration: none;
        transition: all 0.2s;
    }

        .btn-back:hover {
            background: var(--border);
            color: var(--text-dark);
        }

    ::-webkit-scrollbar {
        width: 5px;
    }

    ::-webkit-scrollbar-track {
        background: transparent;
    }

    ::-webkit-scrollbar-thumb {
        background: rgba(0,168,150,0.3);
        border-radius: 10px;
    }
</style>

<!-- ══ SIDEBAR ══ -->
<div class="sidebar">
    <div class="sidebar-logo">
        <div class="logo-icon">🏥</div>
        <h4>ISB Hospital</h4>
        <small>Management System</small>
    </div>

    <div class="nav-section">Main Menu</div>
    <nav>
        <a asp-controller="Admin" asp-action="HelloAdmin"><i class="bi bi-speedometer2"></i> Dashboard</a>
        <a asp-controller="Admin" asp-action="AdminProfile"><i class="bi bi-person-circle"></i> My Profile</a>

        <div class="nav-section" style="padding-left:0">Hospital</div>
        <a asp-controller="Admin" asp-action="HospitalInfo"><i class="bi bi-building"></i> Hospital Info</a>

        <div class="nav-section" style="padding-left:0">Doctors</div>
        <a asp-controller="Admin" asp-action="NewDoctor"><i class="bi bi-person-plus"></i> Add Doctor</a>
        <a asp-controller="Admin" asp-action="ViewDoctor" class="active"><i class="bi bi-person-badge"></i> View Doctors</a>

        <div class="nav-section" style="padding-left:0">Patients</div>
        <a asp-controller="Admin" asp-action="ViewPatient"><i class="bi bi-people"></i> View Patients</a>
    </nav>

    <div class="sidebar-footer">
        <nav>
            <a asp-controller="Admin" asp-action="Logout" class="logout-link">
                <i class="bi bi-box-arrow-left"></i> Logout
            </a>
        </nav>
    </div>
</div>

<!-- ══ TOPBAR ══ -->
<div class="topbar">
    <div class="topbar-left">
        <h6>Doctor Management</h6>
        <h5>Edit Doctor</h5>
    </div>
    <div class="topbar-right">
        <a asp-controller="Admin" asp-action="AdminProfile" class="topbar-profile">
            <img src="@Url.Content("~/images/admin-profile.png")" alt="Admin" />
            <span>@adminName</span>
        </a>
    </div>
</div>

<!-- ══ MAIN ══ -->
<div class="main">
    <div class="content-wrap">
        <div class="form-card">

            <div class="form-card-header">
                <div class="form-card-icon">✏️</div>
                <div>
                    <h5>Edit Doctor Details</h5>
                    <p>Update the information for @Model.DoctorName</p>
                </div>
            </div>

            <div class="form-body">
                <form method="post" asp-controller="Admin" asp-action="EditDoctor" autocomplete="off">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="DoctorId" value="@Model.DoctorId" />

                    <div class="section-label">Doctor Information</div>

                    <div class="mb-3">
                        <label class="form-label">Full Name</label>
                        <input type="text" name="DoctorName" value="@Model.DoctorName"
                               class="form-control" placeholder="Enter full name" required />
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6 mb-3 mb-md-0">
                            <label class="form-label">Email Address</label>
                            <input type="email" name="Email" value="@Model.Email"
                                   class="form-control" placeholder="Enter email"
                                   autocomplete="off" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">
                                Password
                                <span style="color:#a0b8c8;font-size:11px;font-weight:400;">
                                    — leave blank to keep current
                                </span>
                            </label>
                            <input type="password" name="Password" class="form-control"
                                   placeholder="Enter new password" autocomplete="new-password" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Department</label>
                        <select name="Department" class="form-control" required>
                            @foreach (var dept in new[] {
                                                        "Cardiology","Neurology","Orthopedics","Pediatrics",
                                                        "Dermatology","Gynecology","General Surgery","ENT",
                                                        "Ophthalmology","Psychiatry","Radiology","Urology","General Medicine"
                                                        })
                            {
                                if (Model.Department == dept)
                                {
                                    <option value="@dept" selected>@dept</option>
                                }
                                else
                                {
                                    <option value="@dept">@dept</option>
                                }
                            }
                        </select>
                    </div>

                    <div class="section-label mt-4">Availability</div>

                    <div class="mb-3">
                        <label class="form-label">Available Days</label>
                        <select name="AvailableDays" class="form-control">
                            @foreach (var day in new[] {
                                                        "Monday - Friday","Monday - Saturday",
                                                        "Saturday - Sunday","Monday, Wednesday, Friday",
                                                        "Tuesday, Thursday, Saturday","Daily"
                                                        })
                            {
                                if (Model.AvailableDays == day)
                                {
                                    <option value="@day" selected>@day</option>
                                }
                                else
                                {
                                    <option value="@day">@day</option>
                                }
                            }
                        </select>
                    </div>

                    <div class="mb-4">
                        <label class="form-label">Max Patients Per Day</label>
                        <input type="number" name="MaxPatientsPerDay" value="@Model.MaxPatientsPerDay"
                               class="form-control" min="1" max="100" placeholder="e.g. 20" />
                    </div>

                    <div class="btn-row">
                        <a asp-controller="Admin" asp-action="ViewDoctor" class="btn-back">
                            <i class="bi bi-arrow-left"></i> Back
                        </a>
                        <button type="submit" class="btn-update">
                            <i class="bi bi-check2-circle"></i> Save Changes
                        </button>
                    </div>

                </form>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
