@{
    ViewData["Title"] = "AI Health Assistant";
}

<style>
    body {
        background-color: #f0f4f8;
        font-family: Arial, sans-serif;
    }

    .chat-wrapper {
        max-width: 750px;
        margin: 30px auto;
    }

    .chat-title {
        background-color: #1e4f8a;
        color: white;
        text-align: center;
        padding: 15px;
        border-radius: 8px 8px 0 0;
        font-size: 20px;
        font-weight: bold;
    }

    .disclaimer {
        background-color: #fff3cd;
        border: 1px solid #ffc107;
        color: #856404;
        padding: 10px 15px;
        font-size: 13px;
        text-align: center;
    }

    .chat-box {
        background-color: white;
        height: 420px;
        overflow-y: auto;
        padding: 20px;
        border-left: 1px solid #ddd;
        border-right: 1px solid #ddd;
    }

    .msg-user {
        text-align: right;
        margin-bottom: 14px;
    }

        .msg-user span {
            display: inline-block;
            background-color: #1e4f8a;
            color: white;
            padding: 10px 15px;
            border-radius: 15px 15px 0 15px;
            max-width: 70%;
            text-align: left;
        }

    .msg-bot {
        text-align: left;
        margin-bottom: 14px;
    }

        .msg-bot span {
            display: inline-block;
            background-color: #e9ecef;
            color: #333;
            padding: 10px 15px;
            border-radius: 15px 15px 15px 0;
            max-width: 75%;
        }

    .chat-input-area {
        display: flex;
        border: 1px solid #ddd;
        border-top: none;
        background: white;
        padding: 12px;
        gap: 10px;
        border-radius: 0 0 8px 8px;
    }

        .chat-input-area input {
            flex: 1;
            padding: 10px;
            border: 1px solid #ccc;
            border-radius: 6px;
            font-size: 14px;
        }

        .chat-input-area button {
            padding: 10px 22px;
            background-color: #1e4f8a;
            color: white;
            border: none;
            border-radius: 6px;
            font-weight: bold;
            cursor: pointer;
            font-size: 14px;
        }

            .chat-input-area button:hover {
                background-color: #163d6e;
            }

    .doctor-card {
        background: white;
        border: 1px solid #1e4f8a;
        border-radius: 8px;
        padding: 15px;
        margin-top: 20px;
    }

        .doctor-card h5 {
            color: #1e4f8a;
            font-weight: bold;
            margin-bottom: 12px;
        }

    .doctor-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 10px;
        border: 1px solid #ddd;
        border-radius: 6px;
        margin-bottom: 8px;
        background-color: #f9f9f9;
    }

    .doctor-info strong {
        display: block;
        color: #1e4f8a;
        font-size: 14px;
    }

    .doctor-info small {
        color: #666;
        font-size: 12px;
    }

    .book-btn {
        background-color: #28a745;
        color: white;
        border: none;
        padding: 7px 14px;
        border-radius: 5px;
        font-size: 13px;
        cursor: pointer;
        text-decoration: none;
        font-weight: bold;
    }

        .book-btn:hover {
            background-color: #218838;
            color: white;
        }

    .urgency-emergency {
        color: red;
        font-weight: bold;
    }

    .urgency-urgent {
        color: orange;
        font-weight: bold;
    }

    .urgency-routine {
        color: green;
        font-weight: bold;
    }

    .typing {
        color: #888;
        font-style: italic;
        font-size: 13px;
        padding: 5px 10px;
    }
</style>

<div class="chat-wrapper">

    <div class="chat-title">
        🏥 E-Health AI Assistant
    </div>

    <div class="disclaimer">
        ⚠️ This AI provides general health guidance only.
        It is not a substitute for professional medical advice.
        Always consult a licensed doctor.
    </div>

    <div class="chat-box" id="chatBox">
        <div class="msg-bot">
            <span>
                👋 Hello! I am your E-Health AI Assistant.<br><br>
                Please describe your symptoms and I will provide
                health guidance and suggest the right doctor for you.
            </span>
        </div>
    </div>

    <div class="chat-input-area">
        <input type="text" id="userInput"
               placeholder="Example: I have fever and headache..."
               onkeypress="handleEnter(event)" />
        <button onclick="sendMessage()">Send</button>
    </div>

    <div class="doctor-card" id="doctorCard" style="display:none;">
        <h5>👨‍⚕️ Recommended Doctors</h5>
        <div id="doctorList"></div>
    </div>

</div>

<script>
    function handleEnter(e) {
        if (e.key === 'Enter') sendMessage();
    }

    function escapeHtml(text) {
        return text
            .replace(/&/g, "&amp;")
            .replace(/</g, "&lt;")
            .replace(/>/g, "&gt;");
    }

    function addUserMessage(text) {
        var box = document.getElementById('chatBox');
        var div = document.createElement('div');
        div.className = 'msg-user';
        div.innerHTML = '<span>' + escapeHtml(text) + '</span>';
        box.appendChild(div);
        box.scrollTop = box.scrollHeight;
    }

    function addBotMessage(html) {
        var box = document.getElementById('chatBox');
        var div = document.createElement('div');
        div.className = 'msg-bot';
        div.innerHTML = '<span>' + html + '</span>';
        box.appendChild(div);
        box.scrollTop = box.scrollHeight;
    }

    function addTyping() {
        var box = document.getElementById('chatBox');
        var div = document.createElement('div');
        div.id = 'typingDiv';
        div.className = 'typing';
        div.innerText = '⏳ Analyzing your symptoms...';
        box.appendChild(div);
        box.scrollTop = box.scrollHeight;
    }

    function removeTyping() {
        var el = document.getElementById('typingDiv');
        if (el) el.remove();
    }

    function showDoctors(doctors, specialization, urgency) {
        var card = document.getElementById('doctorCard');
        var list = document.getElementById('doctorList');

        if (!doctors || doctors.length === 0) {
            card.style.display = 'none';
            return;
        }

        var urgencyClass = urgency === 'emergency' ? 'urgency-emergency' :
                           urgency === 'urgent' ? 'urgency-urgent' :
                           'urgency-routine';

        var html = '<p>Department: <strong>' + specialization +
            '</strong> &nbsp; Priority: <span class="' + urgencyClass +
            '">' + urgency.toUpperCase() + '</span></p>';

        doctors.forEach(function (doc) {
            var name = doc.doctorName || doc.DoctorName || '';
            var dept = doc.department || doc.Department || '';
            var days = doc.availableDays || doc.AvailableDays || '';
            var id   = doc.doctorId || doc.DoctorId || 0;

            html += '<div class="doctor-item">' +
                '<div class="doctor-info">' +
                '<strong>' + name + '</strong>' +
                '<small>' + dept + '</small><br>' +
                '<small>📅 Available: ' + days + '</small>' +
                '</div>' +
                '<a href="/Patient/BookAppointment?doctorId=' + id +
                '" class="book-btn">Book Appointment</a>' +
                '</div>';
        });

        list.innerHTML = html;
        card.style.display = 'block';
    }

    async function sendMessage() {
        var input = document.getElementById('userInput');
        var message = input.value.trim();
        if (!message) return;

        addUserMessage(message);
        input.value = '';
        addTyping();
        document.getElementById('doctorCard').style.display = 'none';

        try {
            var response = await fetch('/Patient/SendChatMessage', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ message: message, patientId: 0 })
            });

            var data = await response.json();
            removeTyping();

            if (data.error) {
                addBotMessage('⚠️ ' + data.error);
                return;
            }

            // Build bot response text
            var botMsg = '';

            if (data.disease && data.disease !== 'General Health Query') {
                botMsg += '<strong>🔍 Possible Condition: ' +
                    data.disease + '</strong>';
                if (data.confidence > 0) {
                    botMsg += ' <small>(' + data.confidence + '% match)</small>';
                }
                botMsg += '<br><br>';
            }

            botMsg += data.guidance;

            if (data.precautions && data.precautions.length > 0) {
                botMsg += '<br><br><strong>Precautions:</strong>' +
                    '<ul style="margin:5px 0 0 15px;padding:0;">';
                data.precautions.forEach(function (p) {
                    if (p && p !== 'nan' && p !== 'None') {
                        botMsg += '<li>' + p + '</li>';
                    }
                });
                botMsg += '</ul>';
            }

            addBotMessage(botMsg);

            // Show doctor suggestions
            if (data.suggestedDoctors && data.suggestedDoctors.length > 0) {
                showDoctors(
                    data.suggestedDoctors,
                    data.specialization,
                    data.urgency
                );
            }

        } catch (err) {
            removeTyping();
            addBotMessage('⚠️ Could not connect to AI service. ' +
                'Please make sure the AI server is running and try again.');
        }
    }
</script>