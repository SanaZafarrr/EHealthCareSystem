@{
    ViewData["Title"] = "About Us";
}

<!DOCTYPE html>
<html>
<head>
    <title>About Us - ISB E-Health Care</title>

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
</head>
<body style="background-color:#f7f9fc;">

    <!-- ================= HEADER ================= -->
    <div class="container-fluid py-5 text-center"
         style="background: linear-gradient(135deg, #8CA9FF, #AAC4F5); color:white;">
        <h1 class="fw-bold">About ISB E-Health Care</h1>
        <p class="fs-5 mt-2">
            Your Trusted Digital Healthcare Management System
        </p>
    </div>

    <!-- ================= WHO WE ARE ================= -->
    <div class="container mt-5">
        <div class="row align-items-center">

            <div class="col-md-6">
                <h3 class="fw-bold mb-3" style="color:#4a5fd1;">
                    Who We Are
                </h3>
                <p class="text-muted fs-5">
                    ISB E-Health Care is a full-stack web-based healthcare management system
                    designed to simplify hospital operations and improve patient experience.
                    Our platform enables patients, doctors, and administrators to interact
                    efficiently through a secure and user-friendly digital environment.
                </p>
            </div>

            <div class="col-md-6 text-center">
                <img src="https://cdn-icons-png.flaticon.com/512/2966/2966485.png"
                     width="300" />
            </div>

        </div>
    </div>

    <!-- ================= MISSION & VISION ================= -->
    <div class="container mt-5">
        <div class="row g-4">

            <div class="col-md-6">
                <div class="card h-100 shadow-sm border-0">
                    <div class="card-body">
                        <h4 class="fw-bold text-primary">Our Mission</h4>
                        <ul class="mt-3 text-muted">
                            <li>Provide easy and secure online healthcare access</li>
                            <li>Simplify appointment booking and management</li>
                            <li>Enhance patient-doctor communication</li>
                            <li>Reduce manual hospital workload</li>
                            <li>Deliver smart healthcare through technology</li>
                        </ul>
                    </div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="card h-100 shadow-sm border-0">
                    <div class="card-body">
                        <h4 class="fw-bold text-primary">Our Vision</h4>
                        <p class="mt-3 text-muted fs-5">
                            To become a reliable digital healthcare platform that integrates
                            intelligent systems such as AI-based assistance, providing
                            accessible, accurate, and efficient healthcare services anytime,
                            anywhere.
                        </p>
                    </div>
                </div>
            </div>

        </div>
    </div>

    <!-- ================= WHAT WE OFFER ================= -->
    <div class="container mt-5">

        <h3 class="text-center fw-bold mb-4" style="color:#4a5fd1;">
            What We Offer
        </h3>

        <div class="row g-4">

            <div class="col-md-4">
                <div class="card text-center h-100 shadow-sm border-0">
                    <div class="card-body">
                        <img src="https://cdn-icons-png.flaticon.com/512/747/747376.png"
                             width="60" class="mb-3" />
                        <h5>Online Appointments</h5>
                        <p class="text-muted">
                            Book, view, and cancel doctor appointments easily.
                        </p>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card text-center h-100 shadow-sm border-0">
                    <div class="card-body">
                        <img src="https://cdn-icons-png.flaticon.com/512/387/387561.png"
                             width="60" class="mb-3" />
                        <h5>Doctor Management</h5>
                        <p class="text-muted">
                            View experienced doctors and their specialties.
                        </p>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card text-center h-100 shadow-sm border-0">
                    <div class="card-body">
                        <img src="https://cdn-icons-png.flaticon.com/512/4712/4712035.png"
                             width="60" class="mb-3" />
                        <h5>AI Health Assistant</h5>
                        <p class="text-muted">
                            Smart AI-based guidance for basic health queries.
                        </p>
                    </div>
                </div>
            </div>

        </div>
    </div>

    <!-- ================= CORE VALUES ================= -->
    <div class="container mt-5">

        <h3 class="text-center fw-bold mb-4" style="color:#4a5fd1;">
            Our Core Values
        </h3>

        <div class="row g-4 text-center">

            <div class="col-md-3">
                <div class="card h-100 shadow-sm border-0">
                    <div class="card-body">
                        <h5>Patient Care</h5>
                        <p class="text-muted">Patients always come first</p>
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="card h-100 shadow-sm border-0">
                    <div class="card-body">
                        <h5>Integrity</h5>
                        <p class="text-muted">Honest and ethical services</p>
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="card h-100 shadow-sm border-0">
                    <div class="card-body">
                        <h5>Innovation</h5>
                        <p class="text-muted">Technology-driven healthcare</p>
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="card h-100 shadow-sm border-0">
                    <div class="card-body">
                        <h5>Security</h5>
                        <p class="text-muted">Patient data protection</p>
                    </div>
                </div>
            </div>

            <!-- Back Button -->
            <div class="text-center mt-3">
                <a href="@Url.Action("HelloPatient","Patient")"
                   class="btn btn-primary">
                    Back to Dashboard
                </a>
            </div>


        </div>
    </div>

    <!-- ================= FOOTER ================= -->
    <footer class="text-center py-3 text-muted">
        © 2026 ISB E-Health Care | Final Year Project
    </footer>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>
