@model HealthCareSystem.Models.Doctor

@{
    ViewData["Title"] = "Doctor Profile";
}

<!DOCTYPE html>
<html>

<head>

    <meta charset="utf-8" />

    <title>Doctor Profile</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <style>

        body {
            background-color: #F4F9FF;
        }

        .profile-box {
            max-width: 900px;
            margin: auto;
            margin-top: 50px;
            background-color: #E3F2FD;
            padding: 35px;
            border-radius: 12px;
            border-top: 6px solid #0D47A1;
        }

        .title {
            color: #1A237E;
            font-weight: bold;
        }

    </style>

</head>

<body>

    <!-- NAVBAR -->

    <nav class="navbar navbar-expand-lg navbar-dark"
         style="background-color:#4aa3df;">

        <div class="container-fluid">

            <a class="navbar-brand fw-bold">
                ISB E-HealthCare
            </a>

            <ul class="navbar-nav me-auto">

                <li class="nav-item">
                    <a class="nav-link text-white"
                       href="@Url.Action("HelloDoctor","Doctor")">

                        Dashboard

                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link text-white"
                       href="@Url.Action("ManageAppointments","Doctor")">

                        Manage Appointments

                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link text-white"
                       href="@Url.Action("AddPrescription","Doctor")">

                        Add Prescription

                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link text-white"
                       href="@Url.Action("PatientRecords","Doctor")">

                        Patient Records

                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link text-white"
                       href="@Url.Action("DoctorProfile","Doctor")">

                        Doctor Profile

                    </a>
                </li>

            </ul>

        </div>

    </nav>

    <!-- PROFILE -->

    <div class="profile-box shadow">

        <div class="text-center mb-4">

            <h2 class="title">
                Doctor Profile
            </h2>

            <p class="text-muted">

                View doctor information and availability

            </p>

        </div>

        <table class="table table-bordered">

            <tr>
                <th>Doctor ID</th>
                <td>@Model.DoctorId</td>
            </tr>

            <tr>
                <th>Doctor Name</th>
                <td>@Model.DoctorName</td>
            </tr>

            <tr>
                <th>Department</th>
                <td>@Model.Department</td>
            </tr>

            <tr>
                <th>Email</th>
                <td>@Model.Email</td>
            </tr>

            <tr>
                <th>Available Days</th>
                <td>@Model.AvailableDays</td>
            </tr>

            <tr>
                <th>Max Patients Per Day</th>
                <td>@Model.MaxPatientsPerDay</td>
            </tr>

        </table>

    </div>

</body>

</html>