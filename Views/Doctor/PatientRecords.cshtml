@model List<HealthCareSystem.Models.PatientRecordViewModel>

@{
    ViewData["Title"] = "Patient Records";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">

        <h2 class="mb-4">👨‍⚕️ Patient Records</h2>

        <!-- ONLY ADDED BUTTON -->
        <a href="@Url.Action("HelloDoctor","Doctor")"
           class="btn btn-secondary">

            ← Back to Dashboard

        </a>

    </div>

    <table class="table table-hover table-bordered text-center">

        <thead class="table-dark">
            <tr>
                <th>Patient Name</th>
                <th>Action</th>
            </tr>
        </thead>

        <tbody>

            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.PatientName</td>

                    <td>
                        <a class="btn btn-primary"
                           href="@Url.Action("PatientReport","Doctor", new { id = item.UserId })">
                            View Report
                        </a>
                    </td>
                </tr>
            }

        </tbody>

    </table>

</div>