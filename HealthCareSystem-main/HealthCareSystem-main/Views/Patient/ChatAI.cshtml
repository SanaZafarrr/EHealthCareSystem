@{
    ViewData["Title"] = "AI Chatbot";
}

@Html.AntiForgeryToken()

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>AI Healthcare Assistant</title>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <style>

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #e0f2fe 0%, #ffffff 50%, #dbeafe 100%);
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 20px;
        }

        .chat-container {
            width: 100%;
            max-width: 650px;
            height: 90vh;
            background: rgba(255, 255, 255, 0.92);
            border: 1px solid rgba(0,0,0,0.08);
            border-radius: 25px;
            overflow: hidden;
            display: flex;
            flex-direction: column;
            backdrop-filter: blur(18px);
            box-shadow: 0 20px 50px rgba(0,0,0,0.12);
        }

        /* header */

        .chat-header {
            background: linear-gradient(90deg, #06b6d4, #2563eb);
            padding: 18px 25px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            color: white;
        }

        .header-left {
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .bot-icon {
            width: 50px;
            height: 50px;
            border-radius: 50%;
            background: rgba(255,255,255,0.25);
            display: flex;
            justify-content: center;
            align-items: center;
            font-size: 24px;
        }

        .header-title h2 {
            font-size: 20px;
            font-weight: 700;
        }

        .header-title p {
            font-size: 13px;
            opacity: 0.95;
            margin-top: 3px;
        }

        .online-status {
            background: rgba(255,255,255,0.2);
            padding: 8px 14px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 600;
        }

        /* back button */

        .back-btn {
            display: inline-block;
            background: linear-gradient(135deg,#2563eb,#06b6d4);
            color: white;
            padding: 10px 18px;
            border-radius: 12px;
            text-decoration: none;
            font-weight: 600;
            font-size: 14px;
            box-shadow: 0 6px 18px rgba(37,99,235,0.25);
            transition: 0.2s;
        }

            .back-btn:hover {
                transform: translateY(-2px);
                color: white;
            }

        /* chat */

        .chat-box {
            flex: 1;
            overflow-y: auto;
            padding: 25px;
            display: flex;
            flex-direction: column;
            gap: 18px;
        }

            .chat-box::-webkit-scrollbar {
                width: 6px;
            }

            .chat-box::-webkit-scrollbar-thumb {
                background: rgba(0,0,0,0.15);
                border-radius: 20px;
            }

        /* bot */

        .msg-bot {
            align-self: flex-start;
            max-width: 82%;
        }

            .msg-bot span {
                display: inline-block;
                background: #f1f5f9;
                color: #0f172a;
                padding: 14px 18px;
                border-radius: 18px 18px 18px 6px;
                font-size: 14px;
            }

        /* user */

        .msg-user {
            align-self: flex-end;
            max-width: 82%;
        }

            .msg-user span {
                background: linear-gradient(135deg,#06b6d4,#2563eb);
                color: white;
                padding: 14px 18px;
                border-radius: 18px 18px 6px 18px;
                display: inline-block;
            }

        /* input */

        .chat-input {
            padding: 18px;
            border-top: 1px solid rgba(0,0,0,0.08);
            display: flex;
            gap: 12px;
            background: white;
        }

            .chat-input input {
                flex: 1;
                padding: 14px 18px;
                border: 1px solid rgba(0,0,0,0.15);
                border-radius: 14px;
            }

            .chat-input button {
                width: 55px;
                height: 55px;
                border: none;
                border-radius: 14px;
                background: linear-gradient(135deg,#06b6d4,#2563eb);
                color: white;
            }

    </style>
</head>

<body>

    <div class="chat-container">

        <!-- header -->
        <div class="chat-header">

            <div class="header-left">
                <div class="bot-icon">⚕️</div>

                <div>
                    <h2>AI Healthcare Assistant</h2>
                    <p>AI-MEDICAL Assistant</p>
                </div>
            </div>

            <div>● ACTIVE</div>

        </div>

        <!-- back button -->
        <div style="padding:10px; text-align:right;">
            <a asp-action="HelloPatient"
               asp-controller="Patient"
               class="back-btn">
                Back to Dashboard
            </a>
        </div>

        <!-- chat -->
        <div id="chatbox" class="chat-box">

            <div class="msg-bot">
                <span> <strong>Hello! I am your AI Medical Assistant.</strong> 
                    <br><br> I can help with general health guidance.
                    <br><br> ⚠️ No diagnosis or prescription.
                    <br> Emergency: 1122 </span>
            </div>

        </div>

        <!-- input -->
        <div class="chat-input">

            <input type="text" id="message" placeholder="Ask..." />

            <button onclick="sendMessage()">➤</button>

        </div>

    </div>

    <script>

        /* JS unchanged */

    </script>

</body>
</html>