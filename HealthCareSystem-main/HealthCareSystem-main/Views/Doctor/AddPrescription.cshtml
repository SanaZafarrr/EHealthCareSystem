@model List<HealthCareSystem.Models.Appointment>

@inject HealthCareSystem.Data.AppDbContext _context

@{
    ViewData["Title"] = "Add Prescription";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
      rel="stylesheet" />

<style>

    body {
        background-color: #eef5ff;
    }

    .main-card {
        border-radius: 15px;
        overflow: hidden;
        animation: slideUp 0.5s ease;
    }

    @@keyframes slideUp {

        from {
            transform: translateY(20px);
            opacity: 0;
        }

        to {
            transform: translateY(0);
            opacity: 1;
        }
    }

    .table thead {
        background: linear-gradient(135deg, #4aa3df, #2f86c5);
        color: white;
    }

    .btn-custom {
        transition: 0.3s;
    }

        .btn-custom:hover {
            transform: scale(1.05);
        }

</style>

<div class="container mt-5">

    <div class="mb-3">

        <a href="@Url.Action("HelloDoctor","Doctor")"
           class="btn btn-secondary">

            ← Back to Dashboard

        </a>

    </div>

    <div class="card shadow border-0 main-card">

        <div class="card-header bg-primary text-white">

            <h3 class="fw-bold">
                💊 Prescription Management
            </h3>

        </div>

        <div class="card-body">

            <table class="table table-hover text-center align-middle">

                <thead>

                    <tr>

                        <th>Patient Name</th>

                        <th>Appointment Date</th>

                        <th>Status</th>

                        <th>Action</th>

                    </tr>

                </thead>

                <tbody>

                    @foreach (var item in Model)
                    {
                        var prescription =
                        _context.Prescriptions
                        .FirstOrDefault(p =>
                        p.AppointmentId == item.Id);

                        <tr>

                            <td class="fw-bold">
                                @item.PatientName
                            </td>

                            <td>
                                @item.AppointmentDate
                            </td>

                            <td>

                                <span class="badge bg-success">

                                    @item.Status

                                </span>

                            </td>

                            <td>

                                @if (prescription == null)
                                {
                                    <a class="btn btn-success btn-custom"
                                       href="@Url.Action("CreatePrescription",
                                              "Doctor",
                                              new { id = item.Id })">

                                        ➕ Add Prescription

                                    </a>
                                }

                                else
                                {
                                    <a class="btn btn-warning btn-custom"
                                       href="@Url.Action("CreatePrescription",
                                              "Doctor",
                                              new { id = item.Id })">

                                        ✏ Edit Prescription

                                    </a>
                                }

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>